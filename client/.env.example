# Copy to .env.local for local overrides. Vite only exposes VITE_-prefixed
# variables to the bundle, and bakes them in at build time.

# Where the API lives. Leave it unset locally: the Vite dev proxy forwards /api
# to localhost:4000, which keeps requests same-origin and the session cookie
# simple.
#
# In production (Vercel) set it to the Render service, including the /api path:
#   VITE_API_BASE=https://linkvault-api.onrender.com/api
VITE_API_BASE=


