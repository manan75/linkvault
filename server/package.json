{
  "name": "linkvault-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LinkVault API server",
  "main": "src/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.js",
    "start": "node src/index.js",
    "test": "node --test",
    "worker": "node --watch --env-file-if-exists=../.env src/workers/index.js",
    "worker:start": "node src/workers/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.9.5",
    "openai": "^7.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.0.0"
  }
}
