{
  "manifest_version": 3,
  "name": "LinkVault",
  "version": "0.1.0",
  "description": "Save the page you are on to LinkVault, with what your browser can see and a server cannot.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://linkvault-api-uenh.onrender.com/*",
    "http://localhost:4000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to LinkVault"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
