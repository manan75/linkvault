# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000

# Mongo connection string. Matches the local docker-compose service by default.
MONGODB_URI=mongodb://localhost:27017/linkvault

# Secret used to sign auth JWTs. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Origin allowed to call the API with credentials (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173
