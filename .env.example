# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000

# Mongo connection string. Matches the local docker-compose service by default.
MONGODB_URI=mongodb://localhost:27017/linkvault

# Secret used to sign auth JWTs. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Origin allowed to call the API with credentials. Locally this is the Vite dev
# server; in production it must be the exact Vercel URL, scheme included and no
# trailing slash. It is not decoration there: the client is on a different
# registrable domain, so this is the only thing standing between the API and any
# page on the internet reading a signed-in user's bookmarks.
CLIENT_ORIGIN=http://localhost:5173

# The in-process metadata worker that fetches saved pages. Set to false to run
# the API without it. Left unset it is on everywhere except tests.
ENABLE_METADATA_WORKER=true

# Kafka. Off by default: with ENABLE_KAFKA=false the same reaper and worker run
# against an in-process bus, so the app needs no broker. Set to true after
# `docker compose up -d kafka`.
ENABLE_KAFKA=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=linkvault

# --- Enrichment (Phase 5): summary and tag generation ---

# OpenAI API key. Leave empty and enrichment disables itself cleanly -- every
# other stage keeps working, links just arrive without a summary or auto-tags.
OPENAI_API_KEY=

# Model used for summary and tag generation. gpt-5-mini is the cheap tier that
# still has the judgment §3 of the plan depends on -- about $0.60 per 1,000
# links. gpt-5-nano is five times cheaper again and was measured reusing an
# unrelated tag from the vocabulary, so it is not the default.
OPENAI_MODEL=gpt-5-mini

# Left unset it follows the environment: on everywhere except tests. A missing
# OPENAI_API_KEY overrides this either way.
ENABLE_ENRICHMENT=true

# --- Deployment ---

# Redis. Off means rate limit counters live in process memory, which is enough
# while there is one API process. `true` currently fails at startup on purpose:
# the store is a seam waiting for its Phase 7 implementation, and silently
# falling back would hide a misconfiguration rather than report it.
ENABLE_REDIS=false
REDIS_URL=

# Spending bounds. Registration is open, so these are two different instruments
# and both are needed. The per-user cap shapes ordinary use; the daily ceiling
# is global and is what actually stands between a script and the OpenAI bill.
# Over the ceiling, links wait at `pending` and are enriched the next day rather
# than being abandoned.
MAX_LINKS_PER_USER=100
ENRICHMENT_DAILY_LIMIT=200

# How long shutdown may spend closing the server, draining the workers and
# disconnecting MongoDB before it stops waiting and exits anyway. Render follows
# SIGTERM with SIGKILL, so this has to expire first.
SHUTDOWN_TIMEOUT_MS=10000
